# 値を入れて .env.local という名前でコピーして使う（.env.local は Git に含めない）
# 本番ではホスティング先（Netlify など）の環境変数の画面に同じ項目を入れる
# 本物の値（APIキーなど）はここには書かない

# --- サイト ---
# 本番のURL（例：https://jingai-neya.com）。OGP・サイトマップ・Xシェアに使う
NEXT_PUBLIC_SITE_URL=

# --- Supabase（コメント・お問い合わせ・診断の集計） ---
NEXT_PUBLIC_SUPABASE_URL=
# 読み取り用の公開キー（anon key）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 書き込み用の秘密キー（service role key）。絶対に公開しない
SUPABASE_SERVICE_ROLE_KEY=

# --- ボット対策（Cloudflare Turnstile） ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- コメントのAI確認（Claude API） ---
ANTHROPIC_API_KEY=
# 使うモデル（空なら claude-opus-5-5）。費用を抑えるなら claude-haiku-5-5 なども選べる
MODERATION_MODEL=

# --- 連投防止・重複集計防止のハッシュに混ぜる、長いランダムな文字列 ---
HASH_SALT=

# --- お問い合わせの通知メール（Resend） ---
RESEND_API_KEY=
# 通知を受け取るアドレス
CONTACT_NOTIFY_TO=
# 送信元（Resend で認証したドメインのアドレス。例：人外ノ閨 <noreply@jingai-neya.com>）
CONTACT_NOTIFY_FROM=
