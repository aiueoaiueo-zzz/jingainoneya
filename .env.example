# 値を入れて .env.local にコピーして使う（.env.local は Git に含めない）

# --- サイト ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# mock（仮データ）か supabase（本番データ）
DATA_SOURCE=mock

# --- Supabase の secrets に入れる（サイトには置かない） ---
# supabase secrets set DMM_API_ID=... DMM_AFFILIATE_ID=...
# DMM_API_ID=
# DMM_AFFILIATE_ID=   # API用アフィリエイトID（末尾990〜999）
